# Build output lives inside the SDK submodule's tree.
sdk/build/
build/
*.o
*.elf
*.map

# Your credentials. anedya_config.h is tracked with placeholders; if you would
# rather git stopped noticing your edits to it:
#     git update-index --skip-worktree app/ap/include/anedya_config.h
*credentials*.h
secrets.h

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
compile_commands.json
*.log

# Personal tooling, not part of the published example
bk_tool.py

# NOTE: do not add sdk/ or libpeer/ here. They are submodules, and ignoring a
# submodule path stops git from tracking its gitlink, which silently breaks
# 'git clone --recursive' for everyone else.
