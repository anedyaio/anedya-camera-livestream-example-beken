# Capture-side frame buffer sizing.
#
# CONFIG_JPEG_FRAME_SIZE is the capacity of each buffer bk_uvc.c accumulates a
# UVC MJPEG frame into. MJPEG is intra-only, so frame size tracks scene detail
# directly, and at 720p the stock 102400 (100 KB) is not enough for
# high-entropy scenes — pointing the camera at a laptop screen (fine text, high
# contrast, no flat regions) overruns it continuously:
#
#   uvc_stre: Frame buffer overflow: current=102320, need=640
#   jpeg hw_: decoder_error, 102392, ...
#   trs_app:  read frame NULL timeout
#
# The overflow sets packet_error, so the frame is discarded mid-assembly; the
# decoder then chokes on a truncated JPEG, no H.264 frame is produced, and the
# browser eventually PLIs. That path is entirely upstream of the network — it
# is a capture-side truncation, not packet loss.
#
# 204800 is the Kconfig maximum (range 0 204800). An intermediate step at
# 131072 was still overflowed by the laptop-screen case (observed
# current=130960), so this goes straight to the cap.
#
# Budget. Both pools draw on the SAME slab — frame_buffer_fb_malloc() routes
# IMAGE_MJPEG *and* IMAGE_H264 to frame_buffer_encode_malloc(); only IMAGE_YUV
# goes to DISPLAY — so the two sizes must be costed together:
#
#   PSRAM_MEM_SLAB_ENCODE  = 0x157000 = 1404928 B  (partitions/bk7258/ram_regions.csv,
#                                                   grown from the stock 0x0E7000)
#   MJPEG pool  4 buffers  (COMM_FRAME_LIST_MAX_NODE = FRAME_LIST_NODE_MAX - 2)
#   H.264 pool  4 buffers  (H26X_FRAME_LIST_MAX_NODE, CONFIG_MEDIA_PSRAM_SIZE_4M=y)
#   4 * 204800 + 4 * 122880 = 1310720 B, leaving 94208 B (6.7%) spare
#
# That spare is deliberate. An earlier attempt sized these to 98.7% of the slab
# on the arithmetic alone and the allocator failed anyway:
#
#   frame_bu: frame_buffer_fb_malloc 599 malloc fail, img_format:4   (MJPEG)
#   frame_bu: frame_buffer_fb_malloc 599 malloc fail, img_format:8   (H.264)
#   uvc_stre: uvc_camera_stream_eof_handle, 1143 malloc frame fail, length:75742
#
# Each buffer also carries sizeof(frame_buffer_t) + 32 B alignment, and the
# heap has its own block headers and fragmentation. Do not size these past
# ~95% of the slab.
CONFIG_JPEG_FRAME_SIZE=204800

# Raised from the 102400 default: the H.264 encoder was seen overshooting it
# (h264_pip: h264_encode_finish_handle, 103024-102400) on scene changes, which
# is the same truncation failure one stage further down the pipeline. Typical
# frames here are 17-40 KB and a 720p IDR ~75 KB, so 120 KB is ~60% headroom
# over the IDR and covers the observed overshoot.
CONFIG_H264_FRAME_SIZE=122880

