# The board defconfig sets CONFIG_FULL_MBEDTLS=n, which gates an entire
# "#if CONFIG_FULL_MBEDTLS" branch in mbedtls_psa_crypto_config.h containing
# MBEDTLS_GENPRIME, MBEDTLS_SSL_COOKIE_C, MBEDTLS_SSL_DTLS_SRTP,
# MBEDTLS_TIMING_C, MBEDTLS_X509_CRT_WRITE_C, etc. Without it, libpeer's DTLS
# handshake / SRTP keying / RSA keygen symbols are undefined at link time.
CONFIG_FULL_MBEDTLS=y

# Default CONFIG_LWIP_PBUF_POOL_SIZE=10 / CONFIG_LWIP_MEM_SIZE=51200 (50KB)
# are modest for this device's concurrent WiFi + TLS/MQTT + camera + WebRTC
# (RTP/RTCP + STUN/TURN + DTLS) load. First bumped (10->25 / 50KB->100KB)
# for a one-time DTLS handshake failure; that wasn't enough for the
# sustained load of continuous 720p H264 RTP video — "Failed to sendto:
# Not enough space" recurred constantly once actual streaming started, this
# time from agent_send() (no retry loop there, so not a busy-loop bug like
# the DTLS/keepalive ones — genuinely not enough buffer capacity for the
# throughput). Pushed further; may need another pass if this still isn't
# enough, ideally informed by an actual free-heap reading rather than
# another guess.
#
# NOTE: LWIP_MEM_SIZE / MEM_MAX_TX_SIZE / MEM_MAX_RX_SIZE all have
# "range 1 150000" in ap/components/lwip_intf_v2_1/Kconfig. An out-of-range
# value is SILENTLY discarded and falls back to the default — an earlier
# attempt at 153600 here did exactly that, reverting MEM_SIZE to 51200
# while looking like it had been raised. Verify any change to these lands
# in build/.../config/sdkconfig.h rather than trusting this file.
#
# MEM_MAX_TX_SIZE is the real limiter for outbound video: mem.c enforces
#   if (type == MEM_TYPE_TX && lwip_stats.mem.tx_used > MEM_MAX_TX_SIZE)
# and returns NULL (-> ENOMEM, "Not enough space" from sendto). At the
# 42666 default, a single H264 keyframe fragmented into ~40 x 1300-byte RTP
# packets (~52KB) exceeds the cap outright, so no PBUF_POOL_SIZE increase
# could ever have fixed it. Ratios below follow the Kconfig help text's own
# recommendation: TX = (MEM_SIZE*5)/6, RX = (MEM_SIZE*3)/4.
CONFIG_LWIP_PBUF_POOL_SIZE=40
CONFIG_LWIP_MEM_SIZE=150000
CONFIG_LWIP_MEM_MAX_TX_SIZE=125000
CONFIG_LWIP_MEM_MAX_RX_SIZE=112500
